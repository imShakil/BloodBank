# Firebase Functions configuration — template
#
# Values here back the `defineInt`/`defineString` params declared in index.js.
# Copy this file to one of the following (neither is committed; see .gitignore):
#
#   functions/.env                   — local development and the emulator
#   functions/.env.<projectId>       — a specific Firebase project, e.g.
#                                      functions/.env.bloodpoint-prod
#
# A project-specific file wins over .env for that project. The deploy scripts
# (scripts/deploy.sh / deploy.bat) write .env.<projectId> from the environment
# preset before running `firebase deploy --only functions`.

# ---------------------------------------------------------------------------
# Contact request retention period, in days
# ---------------------------------------------------------------------------
# How long contact requests are kept before cleanupOldContactRequests deletes
# them (runs daily at 03:30 UTC).
#
#   Default:        90  (declared in functions/lib/retention.js)
#   Accepted range: 1-3650
#
# Anything outside that range — including 0, a negative number, a fraction or
# a non-numeric value — is rejected at runtime: the function logs a warning and
# falls back to the 90-day default. It is never honoured, because a retention
# of 0 would put the cutoff at "now" and delete every contact request.
#
# Deployed values are resolved at deploy time, so changing this requires a
# redeploy (`firebase deploy --only functions:cleanupOldContactRequests`);
# editing it in the Firebase console alone will not survive the next deploy.
#
# Environment presets used by the deploy scripts: dev 30, staging 60,
# production 90.
#
# See functions/OPERATIONS_RUNBOOK.md for procedures and
# functions/docs/RETENTION_DESIGN.md for the design.
CONTACT_REQUEST_RETENTION_DAYS=90
